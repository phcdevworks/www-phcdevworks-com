{
  "name": "www-phcdevworks-com",
  "description": "www-phcdevworks-com is the public company website for PHCDevworks, serving as the web presence for the company, its products, its technical ecosystem, and its broader brand.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/phcdevworks/www-phcdevworks-com.git"
  },
  "homepage": "https://github.com/phcdevworks/www-phcdevworks-com#readme",
  "bugs": {
    "url": "https://github.com/phcdevworks/www-phcdevworks-com/issues"
  },
  "private": true,
  "type": "module",
  "version": "0.0.1",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "check": "npm run build && npm run typecheck && npm run check:version-sync",
    "check:version-sync": "node --experimental-strip-types scripts/check-readme-version.ts",
    "preview": "npm run build && wrangler dev",
    "astro": "astro",
    "typecheck": "astro check",
    "generate-types": "wrangler types",
    "deploy": "npm run build && wrangler deploy",
    "release:propose": "node scripts/propose-version.js",
    "screenshot": "LD_LIBRARY_PATH=/tmp/chromium-libs/usr/lib/x86_64-linux-gnu node scripts/screenshot.js"
  },
  "peerDependencies": {
    "typescript": "^5.9 || ^6.0"
  },
  "dependencies": {
    "@astrojs/cloudflare": "^14.2.1",
    "@phcdevworks/spectre-tokens": "^4.3.0",
    "@phcdevworks/spectre-ui": "^4.0.0",
    "@phcdevworks/spectre-ui-astro": "^4.4.0",
    "astro": "^7.2.2"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.10",
    "@types/node": "^26.2.0",
    "playwright": "^1.62.1",
    "typescript-eslint": "^8.67.0",
    "vite": "^8.2.1",
    "wrangler": "^4.123.0"
  },
  "allowScripts": {
    "esbuild@0.27.7": true,
    "esbuild@0.28.1": true,
    "esbuild@0.28.2": true,
    "sharp@0.34.5": true,
    "workerd@1.20260730.1": true,
    "workerd@1.20260804.1": true
  }
}
