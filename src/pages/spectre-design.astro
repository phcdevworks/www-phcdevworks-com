---
import Layout from '../layouts/Layout.astro'
import { SpCard, SpButton } from '@phcdevworks/spectre-ui-astro'

const packages = [
  {
    num: '01',
    name: 'Spectre Tokens',
    pkg: '@phcdevworks/spectre-tokens',
    detail: '--sp-* CSS variables and the Tailwind v4 preset. The source of truth for every visual decision downstream.',
    snippet: 'npm install @phcdevworks/spectre-tokens',
  },
  {
    num: '02',
    name: 'Spectre UI',
    pkg: '@phcdevworks/spectre-ui',
    detail: 'Transforms tokens into CSS bundles and component class recipes consumed by framework adapters.',
    snippet: '@import "@phcdevworks/spectre-ui/index.css";',
  },
  {
    num: '03',
    name: 'Spectre UI Astro',
    pkg: '@phcdevworks/spectre-ui-astro',
    detail: 'Typed Astro components — SpCard, SpButton, SpBadge, and more.',
    snippet: "import { SpCard, SpButton } from '@phcdevworks/spectre-ui-astro'",
  },
]

const usageChain = `npm install @phcdevworks/spectre-tokens @phcdevworks/spectre-ui @phcdevworks/spectre-ui-astro

// global.css
@import "@phcdevworks/spectre-ui/index.css";

// Component.astro
import { SpCard, SpButton } from '@phcdevworks/spectre-ui-astro'`
---

<Layout
  title="Spectre Design"
  description="Spectre Design covers Spectre Tokens, Spectre UI, and Spectre UI Astro as the core layers of the Spectre design system."
>
  <section class="page-intro">
    <p class="eyebrow">Spectre Design</p>
    <h1 class="display-headline">Tokens define it. UI builds it. <span>Astro ships it.</span></h1>
    <div class="hero-install">
      <pre class="install-block"><code>npm install @phcdevworks/spectre-ui-astro</code></pre>
    </div>
  </section>

  <section class="section-block">
    <div class="section-heading">
      <p class="eyebrow">Packages</p>
      <h2 class="section-title">Three packages. Each with one job.</h2>
    </div>

    <ol class="spec-list">
      {
        packages.map((pkg) => (
          <li class="spec-list__item">
            <span class="spec-list__num">{pkg.num}</span>
            <div>
              <p class="spec-list__meta">Package</p>
              <h3 class="spec-list__name">{pkg.name}</h3>
              <code class="code-pill spec-list__pkg">{pkg.pkg}</code>
            </div>
            <div class="spec-list__detail-col">
              <p class="spec-list__detail">{pkg.detail}</p>
              <pre class="install-block"><code>{pkg.snippet}</code></pre>
            </div>
          </li>
        ))
      }
    </ol>
  </section>

  <section class="section-block section-band">
    <div class="section-heading">
      <p class="eyebrow">Usage</p>
      <h2 class="section-title">Three packages. One import chain.</h2>
    </div>
    <pre class="code-block"><code>{usageChain}</code></pre>
  </section>

  <section class="home-section">
    <SpCard variant="outline" padded class="home-principles-card home-principles-card--wide">
      <div class="home-principles-card__stack">
        <p class="eyebrow">PHCDevworks</p>
        <h2 class="home-panel-title">The contract is already defined at the token layer.</h2>
        <p class="home-panel-copy">
          Install once. Import anywhere. No custom token system to maintain.
        </p>
        <div class="page-cta-links">
          <SpButton as="a" href="/" variant="ghost">View the full system</SpButton>
        </div>
      </div>
    </SpCard>
  </section>
</Layout>
