---
import Layout from '../layouts/Layout.astro'
import { SpCard, SpButton, SpBadge, SpText } from '@phcdevworks/spectre-ui-astro'

const modules = [
  {
    num: '01',
    name: 'Spectre Shell',
    pkg: '@phcdevworks/spectre-shell',
    detail: 'The thin application frame. Startup sequencing and top-level application boundary.',
    snippet: 'npm install @phcdevworks/spectre-shell',
  },
  {
    num: '02',
    name: 'Spectre Shell Router',
    pkg: '@phcdevworks/spectre-shell-router',
    detail: 'Route registration without coupling route logic to component trees.',
    snippet: 'npm install @phcdevworks/spectre-shell-router',
  },
  {
    num: '03',
    name: 'Spectre Shell Signals',
    pkg: '@phcdevworks/spectre-shell-signals',
    detail: 'Reactive primitives for local UI state. No full state management needed.',
    snippet: 'npm install @phcdevworks/spectre-shell-signals',
  },
]

const installAll = `npm install @phcdevworks/spectre-shell @phcdevworks/spectre-shell-router @phcdevworks/spectre-shell-signals`
---

<Layout
  title="Spectre Shell"
  description="Spectre Shell covers Spectre Shell, Spectre Shell Router, and Spectre Shell Signals as the application-shell side of the Spectre system."
>
  <section class="page-intro">
    <SpText as="p" class="eyebrow">Spectre Shell</SpText>
    <h1 class="display-headline">Shell. Router. <span>Signals.</span></h1>
    <div class="hero-install">
      <pre class="install-block"><code>npm install @phcdevworks/spectre-shell</code></pre>
    </div>
  </section>

  <section class="section-block">
    <div class="section-heading">
      <SpText as="p" variant="subtle" class="eyebrow">Modules</SpText>
      <h2 class="section-title">Three modules. Shell, routing, and state.</h2>
    </div>

    <ol class="spec-list">
      {
        modules.map((mod) => (
          <li class="spec-list__item">
            <span class="spec-list__num">{mod.num}</span>
            <div>
              <SpText as="p" class="spec-list__meta">Module</SpText>
              <h3 class="spec-list__name">{mod.name}</h3>
              <SpBadge as="span" class="code-pill spec-list__pkg">{mod.pkg}</SpBadge>
            </div>
            <div class="spec-list__detail-col">
              <SpText as="p" variant="subtle" class="spec-list__detail">{mod.detail}</SpText>
              <pre class="install-block"><code>{mod.snippet}</code></pre>
            </div>
          </li>
        ))
      }
    </ol>
  </section>

  <section class="section-block section-band">
    <div class="section-heading">
      <SpText as="p" variant="subtle" class="eyebrow">Install</SpText>
      <h2 class="section-title">Three focused modules. Install what you need.</h2>
    </div>
    <pre class="code-block"><code>{installAll}</code></pre>
  </section>

  <section class="home-section">
    <SpCard variant="outline" padded class="home-principles-card home-principles-card--wide">
      <div class="home-principles-card__stack">
        <SpText as="p" variant="subtle" class="eyebrow">PHCDevworks</SpText>
        <h2 class="home-panel-title">The shell stays thin by design.</h2>
        <SpText as="p" variant="subtle" class="home-panel-copy">
          Startup, routing, and reactive state — each its own package. Take only what you need.
        </SpText>
        <div class="page-cta-links">
          <SpButton as="a" href="/" variant="ghost">View the full system</SpButton>
        </div>
      </div>
    </SpCard>
  </section>
</Layout>
