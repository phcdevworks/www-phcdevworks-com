---
import Layout from '../layouts/Layout.astro'
import { SpCard } from '@phcdevworks/spectre-ui-astro'

const systemAreas = [
  {
    title: 'Spectre Design',
    href: '/spectre-design',
    label: 'Tokens / UI / Astro',
    pkg: '@phcdevworks/spectre-ui-astro',
    copy: 'CSS variables, class recipes, and typed Astro components.',
  },
  {
    title: 'Spectre Shell',
    href: '/spectre-shell',
    label: 'Shell / Router / Signals',
    pkg: '@phcdevworks/spectre-shell',
    copy: 'Startup sequencing, route registration, and reactive state.',
  },
  {
    title: 'Spectre WordPress',
    href: '/spectre-wordpress',
    label: 'WordPress / Icons',
    pkg: '@phcdevworks/spectre-wordpress',
    copy: 'Token-aligned delivery for WordPress and page builders.',
  },
]

const engineeringPrinciples = [
  {
    label: '01',
    title: 'Systems over one-offs',
    copy: 'Every product ships against a shared token contract instead of a one-off visual layer.',
  },
  {
    label: '02',
    title: 'Typed, not templated',
    copy: 'Components carry real types end to end — no untyped props, no runtime guesswork.',
  },
  {
    label: '03',
    title: 'Boring on purpose',
    copy: 'Predictable infrastructure that holds up under real engineering load, not demo polish.',
  },
]
---

<Layout
  title="PHCDevworks"
  description="PHCDevworks is an engineering studio building design systems and application infrastructure — Spectre included, not the whole story."
>
  <section class="hero-atmosphere">
    <div class="hero-atmosphere__glow hero-atmosphere__glow--left"></div>
    <div class="hero-atmosphere__glow hero-atmosphere__glow--right"></div>

    <div class="home-hero home-hero--centered">
      <p class="eyebrow eyebrow--centered">PHCDevworks</p>
      <h1 class="home-headline">
        Engineering
        the boring
        <span>internet.</span>
      </h1>
      <p class="home-lead home-lead--centered">
        We build the infrastructure other products stand on — design
        systems, application shells, and the tooling that keeps them
        boring, predictable, and shipped.
      </p>
      <div class="hero-links" aria-label="Primary routes">
        <a href="/spectre-design" class="hero-links__item">Spectre Design</a>
        <a href="/spectre-shell" class="hero-links__item">Spectre Shell</a>
        <a href="/spectre-wordpress" class="hero-links__item">Spectre WordPress</a>
      </div>
    </div>
  </section>

  <section class="home-section">
    <div class="section-heading">
      <p class="eyebrow">Engineering</p>
      <h2 class="section-title">How we build.</h2>
    </div>

    <div class="home-product-grid">
      {
        engineeringPrinciples.map((principle) => (
          <SpCard variant="flat" padded fullHeight class="home-product-card">
            <div class="home-product-card__stack">
              <p class="home-product-card__label">{principle.label}</p>
              <h3 class="home-product-card__title">{principle.title}</h3>
              <p class="home-product-card__copy">{principle.copy}</p>
            </div>
          </SpCard>
        ))
      }
    </div>
  </section>

  <section class="home-section">
    <div class="section-heading">
      <p class="eyebrow">Spectre</p>
      <h2 class="section-title">One platform we build. Not the whole company.</h2>
    </div>

    <div class="home-product-grid">
      {
        systemAreas.map((area) => (
          <SpCard
            as="a"
            href={area.href}
            variant="flat"
            interactive
            padded
            fullHeight
            class="home-product-card"
          >
            <div class="home-product-card__stack">
              <p class="home-product-card__label">{area.label}</p>
              <h3 class="home-product-card__title">{area.title}</h3>
              <code class="code-pill home-product-card__pkg">{area.pkg}</code>
              <p class="home-product-card__copy">{area.copy}</p>
            </div>
          </SpCard>
        ))
      }
    </div>
  </section>
</Layout>
