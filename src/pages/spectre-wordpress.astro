---
import Layout from '../layouts/Layout.astro'
import { SpCard, SpButton } from '@phcdevworks/spectre-ui-astro'

const assets = [
  {
    name: 'Spectre WordPress',
    meta: 'Integration',
    pkg: '@phcdevworks/spectre-wordpress',
    detail: 'CMS delivery aligned with Spectre tokens. Same visual contract, WordPress context.',
    snippet: 'npm install @phcdevworks/spectre-wordpress',
  },
  {
    name: 'Spectre Icons',
    meta: 'Plugin',
    pkg: '@phcdevworks/spectre-icons',
    detail: 'Manifest-driven icon registration and inline SVG rendering for page builders.',
    snippet: 'npm install @phcdevworks/spectre-icons',
  },
]

const installAll = `npm install @phcdevworks/spectre-wordpress @phcdevworks/spectre-icons`
---

<Layout
  title="Spectre WordPress"
  description="Spectre WordPress covers the WordPress side of the Spectre system, including Spectre Icons."
>
  <section class="page-intro">
    <p class="eyebrow">Spectre WordPress</p>
    <h1 class="display-headline">WordPress. <span>Still on-token.</span></h1>
    <div class="hero-install">
      <pre class="install-block"><code>npm install @phcdevworks/spectre-wordpress</code></pre>
    </div>
  </section>

  <section class="section-block">
    <div class="section-heading">
      <p class="eyebrow">Assets</p>
      <h2 class="section-title">Two packages. CMS and icons.</h2>
    </div>

    <div class="asset-list">
      {
        assets.map((asset) => (
          <SpCard variant="outline" padded>
            <div class="asset-card__inner">
              <div class="asset-card__left">
                <p class="spec-list__meta">{asset.meta}</p>
                <h3 class="asset-card__name">{asset.name}</h3>
                <code class="code-pill">{asset.pkg}</code>
              </div>
              <div class="flex flex-col gap-4">
                <p class="asset-card__detail">{asset.detail}</p>
                <pre class="install-block"><code>{asset.snippet}</code></pre>
              </div>
            </div>
          </SpCard>
        ))
      }
    </div>
  </section>

  <section class="section-block section-band">
    <div class="section-heading">
      <p class="eyebrow">Install</p>
      <h2 class="section-title">Both packages in one install.</h2>
    </div>
    <pre class="code-block"><code>{installAll}</code></pre>
  </section>

  <section class="home-section">
    <SpCard variant="outline" padded class="home-principles-card home-principles-card--wide">
      <div class="home-principles-card__stack">
        <p class="eyebrow">PHCDevworks</p>
        <h2 class="home-panel-title">The same contract, delivered in WordPress.</h2>
        <p class="home-panel-copy">
          No drift. No exceptions. Spectre tokens in every environment.
        </p>
        <div class="page-cta-links">
          <SpButton as="a" href="/" variant="ghost">View the full system</SpButton>
        </div>
      </div>
    </SpCard>
  </section>
</Layout>
