---
import { ClientRouter } from 'astro:transitions'
import { SpFooter, SpContainer, SpNavItem, SpText } from '@phcdevworks/spectre-ui-astro'
import '../styles/global.css'

interface Props {
  title: string
  description?: string
}

const {
  title,
  description = 'PHCDevworks builds design systems, application foundations, and technical infrastructure.',
} = Astro.props
const pathname = Astro.url.pathname

const navItems = [
  { href: '/', label: 'PHCDevworks' },
  { href: '/spectre-design', label: 'Spectre Design' },
  { href: '/spectre-shell', label: 'Spectre Shell' },
  { href: '/spectre-wordpress', label: 'Spectre WordPress' },
]
---

<!DOCTYPE html>
<html lang="en" data-spectre-theme="dark">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="generator" content={Astro.generator} />
    <title>{title} | PHCDevworks</title>
    <meta name="description" content={description} />
    <ClientRouter />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Inter:wght@300..700&family=Manrope:wght@300..800&display=swap"
      rel="stylesheet"
    />
  </head>
  <body class="site-body antialiased min-h-screen">
    <div class="site-frame">
      <header class="site-header">
        <div class="site-header__inner">
          <a href="/" class="site-mark" aria-label="PHCDevworks home">
            <SpText as="span" variant="subtle" class="site-mark__eyebrow">Spectre Design System</SpText>
            <SpText as="span" class="site-mark__title">PHCDevworks</SpText>
          </a>

          <nav class="site-nav" aria-label="Primary">
            {
              navItems.map((item) => {
                const isActive =
                  item.href === '/'
                    ? pathname === '/'
                    : pathname.startsWith(item.href)

                return (
                  <SpNavItem
                    href={item.href}
                    class:list={[
                      'site-nav__link',
                      isActive && 'site-nav__link--active',
                    ]}
                  >
                    {item.label}
                  </SpNavItem>
                )
              })
            }
          </nav>
        </div>
      </header>

      <main class="site-main">
        <slot />
      </main>

      <SpFooter bordered class="site-footer">
        <SpContainer class="site-footer__inner">
          <a href="/" class="site-footer__mark" aria-label="PHCDevworks home">
            PHCDevworks
          </a>

          <ul class="site-footer__links">
            {
              navItems.map((item) => (
                <li class="site-footer__links-item">
                  <a href={item.href} class="site-footer__link">
                    {item.label}
                  </a>
                </li>
              ))
            }
          </ul>

          <div class="site-footer__social">
            <a
              class="site-footer__social-link"
              href="https://x.com/phcdevworks"
              aria-label="X"
              target="_blank"
              rel="noopener noreferrer"
            >
              <svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
                <path
                  d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-5.214-6.817L4.99 21.75H1.68l7.73-8.835L1.254 2.25H8.08l4.713 6.231 5.451-6.231Zm-1.161 17.52h1.833L7.084 4.126H5.117l11.966 15.644Z"
                />
              </svg>
            </a>

            <a
              class="site-footer__social-link"
              href="https://github.com/phcdevworks"
              aria-label="GitHub"
              target="_blank"
              rel="noopener noreferrer"
            >
              <svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
                <path
                  d="M12 2C6.477 2 2 6.484 2 12.017c0 4.425 2.865 8.18 6.839 9.504.5.092.682-.217.682-.483 0-.237-.008-.868-.013-1.703-2.782.605-3.369-1.343-3.369-1.343-.454-1.158-1.11-1.466-1.11-1.466-.908-.62.069-.608.069-.608 1.004.07 1.532 1.032 1.532 1.032.892 1.53 2.341 1.088 2.91.832.092-.647.35-1.088.636-1.339-2.221-.253-4.556-1.113-4.556-4.951 0-1.093.39-1.988 1.029-2.688-.103-.253-.446-1.272.098-2.65 0 0 .84-.27 2.75 1.026A9.548 9.548 0 0 1 12 6.844c.85.004 1.705.115 2.504.338 1.909-1.296 2.747-1.026 2.747-1.026.546 1.378.203 2.397.1 2.65.64.7 1.028 1.595 1.028 2.688 0 3.848-2.339 4.695-4.566 4.943.359.31.679.921.679 1.856 0 1.34-.012 2.421-.012 2.751 0 .268.18.58.688.482A10.02 10.02 0 0 0 22 12.017C22 6.484 17.523 2 12 2Z"
                />
              </svg>
            </a>

            <a
              class="site-footer__social-link"
              href="https://www.linkedin.com/company/phcdevworks"
              aria-label="LinkedIn"
              target="_blank"
              rel="noopener noreferrer"
            >
              <svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
                <path
                  d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.446-2.136 2.94v5.666H9.351V9h3.414v1.561h.049c.476-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286ZM5.337 7.433a2.062 2.062 0 1 1 0-4.124 2.062 2.062 0 0 1 0 4.124ZM7.114 20.452H3.56V9h3.554v11.452Z"
                />
              </svg>
            </a>

            <a
              class="site-footer__social-link"
              href="https://www.facebook.com/phcdevworks"
              aria-label="Facebook"
              target="_blank"
              rel="noopener noreferrer"
            >
              <svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
                <path
                  d="M22 12.06C22 6.505 17.523 2 12 2S2 6.505 2 12.06c0 5.02 3.657 9.184 8.438 9.94v-7.03H7.898v-2.91h2.54V9.845c0-2.522 1.492-3.916 3.777-3.916 1.094 0 2.238.196 2.238.196v2.475h-1.26c-1.243 0-1.63.775-1.63 1.57v1.89h2.773l-.443 2.91h-2.33V22c4.78-.756 8.437-4.92 8.437-9.94Z"
                />
              </svg>
            </a>
          </div>

          <SpText as="span" variant="subtle" class="site-footer__meta">
            PHCDevworks &copy; {new Date().getFullYear()}
          </SpText>
        </SpContainer>
      </SpFooter>
    </div>
  </body>
</html>
